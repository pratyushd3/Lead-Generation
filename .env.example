# --- LLM ---
# mock | openai | anthropic
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Discovery sources ---
# mock | google_cse | hunter | composite
DISCOVERY_SOURCE=mock
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=
HUNTER_API_KEY=

# --- Outreach mailer ---
# mock | resend
MAILER_PROVIDER=mock
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=noreply@example.com
OUTREACH_FROM_NAME=Lead Gen Agency

# --- Marketplace payments ---
# mock | stripe
PAYMENTS_PROVIDER=mock
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
MARKETPLACE_SUCCESS_URL=http://localhost:3000/marketplace/success
MARKETPLACE_CANCEL_URL=http://localhost:3000/marketplace

# --- Storage ---
DATABASE_URL=sqlite:///./leadgen.db

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- CORS for the Next.js dashboard ---
CORS_ORIGINS=http://localhost:3000
